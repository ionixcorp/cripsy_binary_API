# Credenciales de IQ Option (cuenta demo).
# Copiar a .env y completar. NUNCA commitear .env.

IQOPTION_EMAIL = "tu-correo@ejemplo.com"
IQOPTION_PASSWORD = "tu-contrasena"

# --- Deriv (API moderna, segunda integración) ---
# Sin estas claves la API funciona en modo público y gratuito: catálogo,
# velas, ticks y cotización de payout.
# Para operar hacen falta credenciales propias: PAT con scope `trade`
# (o access token OAuth). `DERIV_APPID` solo es obligatorio con PAT.
DERIV_TOKEN=
DERIV_APPID=
# Opcional: cuenta concreta (demo DOT…/VRTC…, real CR…). Si falta, se elige la
# primera del tipo indicado en `DerivConfig.account`.
DERIV_ACCOUNT_ID=
